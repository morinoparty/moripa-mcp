# moripa-mcp local dev
PORT=3000
# Multi-server mapping (JSON). Each value needs baseUrl + service token.
# Example:
# MC_SERVERS_JSON={"lobby":{"baseUrl":"http://lobby:8080","token":"..."},"survival":{"baseUrl":"http://survival:8080","token":"..."}}
MC_SERVERS_JSON={"lobby":{"baseUrl":"http://localhost:8080","token":"CHANGE_ME"}}
